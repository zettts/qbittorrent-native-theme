/* qBittorrent Native — Light (universal, no OS binding) */

QToolBar#toolBar {
    background: #F7F7F7;
    color: #202020;
    border: none;
    border-bottom: 1px solid #D9D9D9;
    spacing: 0px;
    padding: 0px 5px;
    margin: 0px;
    min-height: 40px;
    max-height: 40px;
    qproperty-iconSize: 24px 24px;
}

/*
   No QToolButton min-height/max-height (or hover/pressed background) rule
   here on purpose: styling QToolButton inside this toolbar was found, via
   direct A/B testing on qBittorrent 5.2.3, to misplace the leading
   search-icon of the neighboring "Filter torrents" QLineEdit, even though
   the two are different widgets. Buttons render with default/native look
   until a narrower-scoped fix is found.
*/

QToolBar#toolBar QToolButton::menu-indicator {
    image: url(:/uitheme/icons/chevron-down.svg);
    width: 10px;
    height: 7px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 1px;
}

/*
   qBittorrent (as of 5.2.3) turns toolbar separators into plain QWidget
   spacers with minimumWidth=16, plus two 8px QWidget spacers, so styling
   QToolBar::separator alone cannot remove them. Match the spacer widgets
   by their minimumWidth Qt property and zero them out. The expanding
   spacer that pushes Search/Filter to the right has no 8/16px
   minimumWidth and is intentionally left untouched.
*/
QToolBar#toolBar QWidget[minimumWidth="16"],
QToolBar#toolBar QWidget[minimumWidth="8"] {
    qproperty-minimumWidth: 0;
    qproperty-maximumWidth: 0;
    min-width: 0px;
    max-width: 0px;
    width: 0px;
    margin: 0px;
    padding: 0px;
    border: none;
    background: transparent;
}

QToolBar#toolBar::separator,
QToolBar::separator {
    background: transparent;
    border: none;
    width: 0px;
    margin: 0px;
    padding: 0px;
}

/* Preferences sidebar */
QListWidget#categoriesList,
QListView#categoriesList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#categoriesList::item,
QListView#categoriesList::item {
    color: #202020;
    background: transparent;
    border: none;
    padding: 4px 6px;
    margin: 1px 3px;
    border-radius: 6px;
}
QListWidget#categoriesList::item:hover,
QListView#categoriesList::item:hover { background: #EAEAEA; }
QListWidget#categoriesList::item:selected,
QListView#categoriesList::item:selected {
    background: #3584E4;
    color: #FFFFFF;
}

/*
   Draw item checkboxes from theme resources instead of the native macOS
   control. macOS 27 can make Qt's native indicators invisible in the
   Add Torrent file tree and torrent Content view.
*/
QCheckBox::indicator,
QGroupBox::indicator,
QTreeView::indicator {
    width: 16px;
    height: 16px;
}
QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QTreeView::indicator:checked {
    image: url(:/uitheme/icons/checkbox-checked.svg);
}
QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked,
QTreeView::indicator:unchecked {
    image: url(:/uitheme/icons/checkbox-unchecked.svg);
}
QCheckBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate,
QTreeView::indicator:indeterminate {
    image: url(:/uitheme/icons/checkbox-indeterminate.svg);
}
