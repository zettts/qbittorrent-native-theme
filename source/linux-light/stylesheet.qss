/* qBittorrent Native v8 — linux-light */
QToolBar#toolBar {
    background: #F6F5F4;
    color: #241F31;
    border: none;
    border-bottom: 1px solid #D7D3D0;
    spacing: 0px;
    padding: 0px 5px;
    margin: 0px;
    min-height: 40px;
    max-height: 40px;
    qproperty-iconSize: 24px 24px;
}

QToolBar#toolBar QToolButton {
    color: #241F31;
    background: transparent;
    border: none;
    min-width: 30px;
    max-width: 30px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
    margin: 0px;
    border-radius: 6px;
}
QToolBar#toolBar QToolButton:hover { background: #EDEBE9; }
QToolBar#toolBar QToolButton:pressed,
QToolBar#toolBar QToolButton:checked { background: #DEDAD7; }
QToolBar#toolBar QToolButton::menu-indicator {
    image: url(:/uitheme/icons/chevron-down.svg);
    width: 10px;
    height: 7px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 1px;
}

QToolBar#toolBar::separator,
QToolBar::separator {
    background: transparent;
    border: none;
    width: 0px;
    margin: 0px;
    padding: 0px;
}

/* Preferences sidebar: keep platform geometry, normalize icon/text palette. */
QListWidget#categoriesList,
QListView#categoriesList {
    background: #F6F5F4;
    color: #241F31;
    border: none;
    outline: none;
}
QListWidget#categoriesList::item,
QListView#categoriesList::item {
    color: #241F31;
    background: transparent;
    border: none;
    padding: 4px 6px;
    margin: 1px 3px;
    border-radius: 6px;
}
QListWidget#categoriesList::item:hover,
QListView#categoriesList::item:hover { background: #EDEBE9; }
QListWidget#categoriesList::item:selected,
QListView#categoriesList::item:selected {
    background: #3584E4;
    color: #FFFFFF;
}
