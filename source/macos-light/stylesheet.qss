/* qBittorrent macOS Light v6 — qBittorrent 5.2.3 / macOS light */

QToolBar#toolBar {
    background: #FCFCFC;
    border: none;
    border-bottom: 1px solid #E5E5E5;
    spacing: 0px;
    padding: 0px 5px;
    margin: 0px;
    min-height: 40px;
    max-height: 40px;
    qproperty-iconSize: 24px 24px;
}

/*
   No QToolButton min-height/max-height (or hover/pressed background) rule
   here on purpose: on this display's non-integer scaling, styling
   QToolButton inside this toolbar was found to misplace the leading
   search-icon of the neighboring "Filter torrents" QLineEdit, even though
   the two are different widgets. Confirmed by direct A/B testing. Buttons
   render with default/native look until a narrower-scoped fix is found.
*/

QToolBar#toolBar QToolButton::menu-indicator {
    image: url(:/uitheme/icons/chevron-down.svg);
    width: 10px;
    height: 7px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 1px;
}

/*
   qBittorrent 5.2.3 on macOS converts toolbar separators into ordinary
   QWidget spacers with minimumWidth=16. It also adds two 8px QWidget
   spacers. Because they are no longer QToolBar::separator objects, styling
   QToolBar::separator cannot remove them.

   Match those exact spacer widgets by their minimumWidth Qt property and
   reset the QWidget geometry properties themselves. The expanding spacer
   that pushes Search/Filter to the right has no 8/16px minimumWidth and is
   intentionally left untouched.
*/
QToolBar#toolBar QWidget[minimumWidth="16"],
QToolBar#toolBar QWidget[minimumWidth="8"] {
    qproperty-minimumWidth: 0;
    qproperty-maximumWidth: 0;
    min-width: 0px;
    max-width: 0px;
    width: 0px;
    margin: 0px;
    padding: 0px;
    border: none;
    background: transparent;
}

/* Fallback for non-macOS / later qBittorrent builds where separators remain separators. */
QToolBar#toolBar::separator,
QToolBar::separator {
    background: transparent;
    border: none;
    width: 0px;
    margin: 0px;
    padding: 0px;
}
